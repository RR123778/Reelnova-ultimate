<script>
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

let scenes = [];
let index = 0;

//  Generate Script
function generate(){
  const prompt = document.getElementById("prompt").value.trim();

  if(!prompt){
    alert("Topic !");
    return;
  }

  scenes = [
    " " + prompt,
    "   ?",
    prompt + "   ",
    "Top tips follow ",
    "Final secret "
  ];

  document.getElementById("script").value = scenes.join("\n");

  //  FIRST SCENE   (blank fix)
  drawScene(scenes[0]);
}

//  Preview
function playVideo(){
  if(scenes.length === 0){
    alert(" Generate !");
    return;
  }

  index = 0;
  nextScene();
}

function nextScene(){
  if(index >= scenes.length) return;

  drawScene(scenes[index]);

  index++;
  setTimeout(nextScene, 2000);
}

//  Draw Scene (main fix)
function drawScene(text){
  // background
  ctx.fillStyle = "#111";
  ctx.fillRect(0,0,360,640);

  // text
  ctx.fillStyle = "white";
  ctx.font = "20px Arial";

  // wrap text
  let words = text.split(" ");
  let line = "";
  let y = 200;

  for(let i=0;i<words.length;i++){
    let testLine = line + words[i] + " ";
    let w = ctx.measureText(testLine).width;

    if(w > 300){
      ctx.fillText(line,20,y);
      line = words[i] + " ";
      y += 30;
    } else {
      line = testLine;
    }
  }
  ctx.fillText(line,20,y);
}

//  Voice
function speakAll(){
  if(scenes.length === 0){
    alert("Generate first!");
    return;
  }

  let msg = new SpeechSynthesisUtterance(scenes.join(". "));
  speechSynthesis.speak(msg);
}

//  Record (basic safe)
let recorder, chunks=[];

function record(){
  if(!canvas.captureStream){
    alert("Recording not supported");
    return;
  }

  let stream = canvas.captureStream(30);
  recorder = new MediaRecorder(stream);

  chunks = [];

  recorder.ondataavailable = e => chunks.push(e.data);

  recorder.onstop = ()=>{
    let blob = new Blob(chunks,{type:"video/webm"});
    window.videoURL = URL.createObjectURL(blob);
    alert("Recording done!");
  };

  recorder.start();
  playVideo();

  setTimeout(()=>recorder.stop(), scenes.length * 2000);
}

//  Download
function download(){
  if(!window.videoURL){
    alert(" Record !");
    return;
  }

  let a = document.createElement("a");
  a.href = window.videoURL;
  a.download = "video.webm";
  a.click();
}

//  Share
function share(){
  window.open("https://wa.me/?text=Check this AI tool");
}
</script>